{
  "components": {
    "schemas": {
      "DataMode": {
        "description": "Qualification rules for data consumed by a run.",
        "enum": [
          "current_research",
          "strict_historical"
        ],
        "title": "DataMode",
        "type": "string"
      },
      "DeploymentStage": {
        "description": "Whether and how a run may affect an account.",
        "enum": [
          "research",
          "shadow",
          "paper",
          "limited_live"
        ],
        "title": "DeploymentStage",
        "type": "string"
      },
      "Envelope": {
        "properties": {
          "context": {
            "$ref": "#/components/schemas/ResponseContext"
          },
          "data": {
            "title": "Data"
          }
        },
        "required": [
          "data",
          "context"
        ],
        "title": "Envelope",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "ResponseContext": {
        "properties": {
          "as_of": {
            "format": "date-time",
            "title": "As Of",
            "type": "string"
          },
          "coverage": {
            "additionalProperties": true,
            "title": "Coverage",
            "type": "object"
          },
          "data_mode": {
            "$ref": "#/components/schemas/DataMode"
          },
          "dataset_version_ids": {
            "items": {
              "type": "string"
            },
            "title": "Dataset Version Ids",
            "type": "array"
          },
          "deployment_stage": {
            "$ref": "#/components/schemas/DeploymentStage"
          },
          "model_version_ids": {
            "items": {
              "type": "string"
            },
            "title": "Model Version Ids",
            "type": "array"
          },
          "run_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Run Id"
          },
          "system_as_of": {
            "format": "date-time",
            "title": "System As Of",
            "type": "string"
          },
          "trust_state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Trust State"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "title": "Warnings",
            "type": "array"
          }
        },
        "required": [
          "as_of",
          "system_as_of",
          "data_mode",
          "deployment_stage"
        ],
        "title": "ResponseContext",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "summary": "Read-only P1 capability and governance API",
    "title": "A-Share Platform Next",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
